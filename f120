#!/bin/sh
# f120 - Force120Hz 1.0.1 控制工具
#   f120 status              一条命令看全部（配置 / 安装 / marker / 崩溃 / 日志）
#   f120 on | off            120Hz 总开关
#   f120 launch on|off       启动动画加速开关
#   f120 divisor 3.0         加速倍数（1.0 = 不加速，默认 3.0，上限 60）
#   f120 set <key> <value>   设置任意键（true/false 写成布尔）
#   f120 log [n]             看运行日志
#   f120 crash               看崩溃诊断（dylib 被注入后崩了才会写）
#   f120 probe               列出 SpringBoard 里真实的 SBApp* 类名（诊断用）
#   f120 install             看 postinst 每一步的安装轨迹
#   f120 clear               清空 日志+崩溃
#   f120 safemode [on|off]   安全模式（只写 marker，不装 hook）★ 卡死时用
#   f120 panic               紧急救援：禁用注入 + 重启 SpringBoard ★ 黑屏循环时用
#   f120 sb                  重启 SpringBoard
#
# ★ 关键判据：
#     marker  存在  → dylib 被注入了
#     .crash  有内容 → dylib 注入后崩溃（贴回来即可定位）
#     两者都无      → 注入环节本身失败，与插件代码无关
#
# ★ 注意：1.0.1 起配置读写不再依赖 plutil —— 直接改写 XML。
#     之前 plutil -extract 在这台设备上会静默失败，导致 status 显示空值。
#   LaunchSpeedup / LaunchDivisor 只在 SpringBoard 进程内读，改完必须 f120 sb。
#   Force120 是运行时开关，改 plist 后同样需要重启进程才生效。

P=/var/mobile/Library/Preferences
PREFS="$P/com.minis.force120hz.plist"
LOG="$P/com.minis.force120hz.log"
CRASH="$P/com.minis.force120hz.crash"
INST="$P/com.minis.force120hz.install.log"
MARKER="$P/com.minis.force120hz.loaded"
STATUS="$P/com.minis.force120hz.status"
SBSTATUS="$P/com.minis.force120hz.sbstatus"
DL=/var/jb/Library/MobileSubstrate/DynamicLibraries/Force120Hz.dylib
VER=1.0.9

# ---- 纯 POSIX 的 plist 读取（不依赖 plutil / awk，只用 grep+sed）----
# 设备上没装 awk！所以这里全程 grep+sed。postinst 把 key 和值写在同一行，
# 这里也兼容值在下一行的 plutil 格式。
getv() {
  [ -f "$PREFS" ] || { echo ""; return; }
  # 取包含该 key 的那一行
  line=$(grep -m1 "<key>$1</key>" "$PREFS" 2>/dev/null) || { echo ""; return; }
  # 同行的值：删掉 key 标签及之前的所有内容
  v=$(printf '%s' "$line" | sed "s/.*<key>$1<\/key>[[:space:]]*//; s/[[:space:]]*$//")
  case "$v" in
    "<true/>"*)  echo "true";  return ;;
    "<false/>"*) echo "false"; return ;;
    "<real>"*)   printf '%s\n' "$v" | sed 's/<\/real>//; s/<real>//; s/[[:space:]]//g'; return ;;
    "<integer>"*) printf '%s\n' "$v" | sed 's/<\/integer>//; s/<integer>//; s/[[:space:]]//g'; return ;;
    "<string>"*) printf '%s\n' "$v" | sed 's/<\/string>//; s/<string>//'; return ;;
    "") : ;;  # 值在下一行，下面处理
    *) return ;;
  esac
  # 值在下一行：grep -A1 拿 key 行 + 下一行，取第二行
  nxt=$(grep -A1 -m1 "<key>$1</key>" "$PREFS" 2>/dev/null | sed -n '2p')
  case "$nxt" in
    *"<true/>"*)  echo "true" ;;
    *"<false/>"*) echo "false" ;;
    *"<real>"*)   printf '%s\n' "$nxt" | sed 's/.*<real>//; s/<\/real>.*//; s/[[:space:]]//g' ;;
    *"<integer>"*) printf '%s\n' "$nxt" | sed 's/.*<integer>//; s/<\/integer>.*//; s/[[:space:]]//g' ;;
    *"<string>"*) printf '%s\n' "$nxt" | sed 's/.*<string>//; s/<\/string>.*//' ;;
    *) echo "" ;;
  esac
}

# ---- 纯 POSIX 的 plist 写入：四个键固定，整文件重写（不可能写坏）----
setv() {
  key="$1"; val="$2"
  [ -f "$PREFS" ] || { echo "!! no config $PREFS"; return 1; }
  case "$key" in
    Force120|LaunchSpeedup|DebugLog)
      case "$val" in
        true|false) ;;
        *) echo "!! $key must be true or false"; return 1 ;;
      esac ;;
    LaunchDivisor)
      case "$val" in
        ''|*[!0-9.]*) echo "!! LaunchDivisor must be numeric (e.g. 3.0)"; return 1 ;;
      esac ;;
    *) echo "!! unknown key $key (Force120 / LaunchSpeedup / LaunchDivisor / DebugLog)"; return 1 ;;
  esac

  # 先读现有四个值，缺失的用默认
  n_force=$(getv Force120);      [ -z "$n_force" ] && n_force=true
  n_launch=$(getv LaunchSpeedup); [ -z "$n_launch" ] && n_launch=true
  n_div=$(getv LaunchDivisor);   [ -z "$n_div" ] && n_div=3.0
  n_dbg=$(getv DebugLog);        [ -z "$n_dbg" ] && n_dbg=true

  # 覆盖被修改的那个
  case "$key" in
    Force120)      n_force="$val" ;;
    LaunchSpeedup) n_launch="$val" ;;
    LaunchDivisor) n_div="$val" ;;
    DebugLog)      n_dbg="$val" ;;
  esac

  booltag() { [ "$1" = "true" ] && echo "<true/>" || echo "<false/>"; }

  {
    echo '<?xml version="1.0" encoding="UTF-8"?>'
    echo '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
    echo '<plist version="1.0">'
    echo '<dict>'
    printf '\t<key>Force120</key> %s\n'      "$(booltag "$n_force")"
    printf '\t<key>LaunchSpeedup</key> %s\n' "$(booltag "$n_launch")"
    printf '\t<key>LaunchDivisor</key> <real>%s</real>\n' "$n_div"
    printf '\t<key>DebugLog</key> %s\n'      "$(booltag "$n_dbg")"
    echo '</dict>'
    echo '</plist>'
  } > "${PREFS}.new" && mv "${PREFS}.new" "$PREFS"

  chown mobile:mobile "$PREFS" 2>/dev/null
  chmod 644 "$PREFS" 2>/dev/null
  notify_post com.minis.force120hz.reload 2>/dev/null
  echo "$key = $(getv "$key")"
}

notify_post_key() {
  notifyutil -p "$1" 2>/dev/null || notify_post "$1" 2>/dev/null
}

case "$1" in
  status|"")
    echo "== Force120Hz $VER =="

    echo "-- config ($PREFS) --"
    if [ -s "$PREFS" ]; then
      for k in Force120 LaunchSpeedup LaunchDivisor DebugLog; do
        printf "   %-16s %s\n" "$k" "$(getv $k)"
      done
    else
      echo "   !! config missing"
    fi

    echo "-- install location --"
    ls -l "$DL" 2>/dev/null | sed 's/^/   /' || echo "   !! missing $DL"
    ls -l "${DL%.dylib}.plist" 2>/dev/null | sed 's/^/   /' || echo "   !! missing plist"

    echo "-- marker (authoritative: was dylib injected?) --"
    if [ -s "$MARKER" ]; then
      # marker 是追加写：每个被注入的进程一行。先汇总，再看明细。
      total=$(wc -l < "$MARKER" | tr -d ' ')
      echo "   injected processes: $total"
      if grep -q 'sb=1' "$MARKER"; then
        echo "   SpringBoard: INJECTED"
      else
        echo "   SpringBoard: NOT injected (only App processes)"
      fi
      if grep -q 'safe=1' "$MARKER"; then
        echo "   !! SAFEMODE marker present -> all hooks disabled"
        echo "      fix: rm -f $P/com.minis.force120hz.safemode; killall -9 SpringBoard"
      fi
      echo "   -- last 6 entries --"
      tail -n 6 "$MARKER" | sed 's/^/   /'
    else
      echo "   !! NO marker = dylib was never injected"
    fi

    echo "-- crash diagnostics --"
    if [ -s "$CRASH" ]; then
      cat "$CRASH" | sed 's/^/   /'
      echo "   ^^ dylib crashed after injection. Paste these lines."
    else
      echo "   none (no crash)"
    fi

    echo "-- SpringBoard status (authoritative for launch speedup) --"
    if [ -s "$SBSTATUS" ]; then
      cat "$SBSTATUS" | sed 's/^/   /'
    else
      echo "   !! no SpringBoard status (SB not injected, or never initialised)"
    fi

    echo "-- last process status (informational only) --"
    if [ -s "$STATUS" ]; then
      head -n 2 "$STATUS" | sed 's/^/   /'
    else
      echo "   (none)"
    fi

    echo "-- package version --"
    dpkg -l 2>/dev/null | grep -i force120hz | sed 's/^/   /' || echo "   (not found via dpkg -l)"

    echo "-- log tail --"
    if [ -s "$LOG" ]; then
      tail -n 15 "$LOG" | sed 's/^/   /'
    else
      echo "   (no log)"
    fi
    ;;
  on)     setv Force120 true ;;
  off)    setv Force120 false ;;
  launch)
    case "$2" in
      on)  setv LaunchSpeedup true ;;
      off) setv LaunchSpeedup false ;;
      *)   echo "usage: f120 launch on|off"; exit 1 ;;
    esac
    echo "   requires: f120 sb"
    ;;
  divisor)
    [ -z "$2" ] && { echo "usage: f120 divisor <n, e.g. 3.0>"; exit 1; }
    setv LaunchDivisor "$2"
    echo "   requires: f120 sb  (1.0 = off, max 30)"
    ;;
  set)    [ -z "$3" ] && { echo "usage: f120 set <key> <value>"; exit 1; }; setv "$2" "$3" ;;
  log)    tail -n "${2:-80}" "$LOG" 2>/dev/null || echo "(no log)" ;;
  crash)  cat "$CRASH" 2>/dev/null || echo "(no crash record)" ;;
  probe)
    echo "== SBApp* classes with duration-ish selectors =="
    if [ -s "$LOG" ]; then
      grep -A400 "probe SBApp" "$LOG" | grep -E "probe |HIT " | sed "s/^/   /"
      echo ""
      echo "  (empty = plugin has not run probe yet; run: f120 launch on && f120 sb)"
    else
      echo "   (no log)"
    fi
    ;;
  install) tail -n "${2:-60}" "$INST" 2>/dev/null || echo "(no install log)" ;;
  clear)  : > "$LOG"; : > "$CRASH"; echo "log and crash cleared" ;;
  safemode)
    case "$2" in
      on)
        : > "$P/com.minis.force120hz.safemode"
        echo "SAFEMODE ON (marker only, no hooks). Restarting SpringBoard..."
        killall -9 SpringBoard
        ;;
      off)
        rm -f "$P/com.minis.force120hz.safemode"
        echo "SAFEMODE OFF. Restarting SpringBoard..."
        killall -9 SpringBoard
        ;;
      *)
        if [ -f "$P/com.minis.force120hz.safemode" ]; then
          echo "SafeMode: ON (all hooks disabled)"
        else
          echo "SafeMode: OFF (normal)"
        fi
        echo "usage: f120 safemode on|off"
        ;;
    esac
    ;;
  panic)
    # 卡死/黑屏循环时的救援：先禁用一切注入，再重启 SpringBoard。
    # 完全不依赖 dpkg —— 只要还能进终端就能救回来。
    echo "== EMERGENCY =="
    mv /var/jb/Library/MobileSubstrate/DynamicLibraries/Force120Hz.plist \
       /tmp/Force120Hz.plist.disabled 2>/dev/null && echo "  plist moved away -> ellekit will not load this tweak"
    : > "$P/com.minis.force120hz.safemode" 2>/dev/null && echo "  safemode marker written"
    echo "  restarting SpringBoard..."
    killall -9 SpringBoard
    echo ""
    echo "  If recovered: dpkg -r com.minis.force120hz, then report findings."
    ;;
  sb)     killall -9 SpringBoard; echo "SpringBoard restarted (wait 15-20s, then f120 status)" ;;
  *)      sed -n '2,22p' "$0" ;;
esac
